# ==============================================================================
# nemo-langgraph-agent Configuration Template
# Copy this file to .env and adjust variables to match your local environment.
# ==============================================================================

# Local Model Endpoint (LM Studio, Ollama, vLLM, or LocalAI)
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL_NAME=nvidia-nemotron-3.5-bolt-e4b-4gb
LOCAL_OPENAI_API_KEY=lmstudio

# Temperature for agent reasoning and tool calling
AGENT_TEMPERATURE=0.2

# Default persistent conversation thread ID
DEFAULT_THREAD_ID=main-session

# Set to 'true' to bypass the interactive Human-in-the-Loop review prompt before code execution
AUTO_APPROVE_CODE_EXECUTION=false

# Comma-separated list of additional directories prohibited from read/write/execution access
# Example: ADDITIONAL_PROTECTED_PATHS=C:/Secrets,D:/PrivateData,/opt/secure
ADDITIONAL_PROTECTED_PATHS=
